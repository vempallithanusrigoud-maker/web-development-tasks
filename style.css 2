/* ==============================
   BASIC RESET
================================= */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, sans-serif;
    line-height: 1.6;
    color: #1e293b;
    background-color: #ffffff;
}


/* ==============================
   NAVIGATION
================================= */

.navbar {
    position: sticky;
    top: 0;
    z-index: 1000;

    display: flex;
    justify-content: space-between;
    align-items: center;

    padding: 18px 8%;

    background-color: #0f172a;
}

.logo {
    font-size: 28px;
    font-weight: bold;
    color: #38bdf8;
}

.navbar nav {
    display: flex;
    gap: 25px;
}

.navbar nav a {
    color: white;
    text-decoration: none;
    font-size: 15px;

    transition: 0.3s;
}

.navbar nav a:hover {
    color: #38bdf8;
}


/* ==============================
   HERO
================================= */

.hero {
    min-height: 90vh;

    display: flex;
    justify-content: space-between;
    align-items: center;

    gap: 50px;

    padding: 80px 10%;

    background-color: #f0f9ff;
}

.hero-text {
    max-width: 650px;
}

.welcome {
    color: #0284c7;
    font-size: 14px;
    font-weight: bold;
    letter-spacing: 2px;

    margin-bottom: 15px;
}

.hero h1 {
    font-size: 55px;
    line-height: 1.2;

    color: #0f172a;

    margin-bottom: 10px;
}

.hero h1 span {
    color: #0284c7;
}

.hero h2 {
    font-size: 25px;
    color: #475569;

    margin-bottom: 20px;
}

.hero-text > p:not(.welcome) {
    font-size: 18px;
    color: #64748b;

    margin-bottom: 30px;
}

.btn {
    display: inline-block;

    padding: 13px 28px;

    background-color: #0284c7;
    color: white;

    text-decoration: none;

    border-radius: 8px;

    font-weight: bold;

    transition: 0.3s;
}

.btn:hover {
    background-color: #0369a1;
    transform: translateY(-2px);
}


/* ==============================
   PROFILE PLACEHOLDER
================================= */

.profile-box {
    text-align: center;
}

.profile-circle {
    width: 240px;
    height: 240px;

    display: flex;
    justify-content: center;
    align-items: center;

    border-radius: 50%;

    background-color: #bae6fd;

    border: 8px solid white;

    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.12);
}

.profile-circle span {
    font-size: 65px;
    font-weight: bold;
    color: #0284c7;
}

.profile-box p {
    margin-top: 12px;
    color: #64748b;
}


/* ==============================
   COMMON SECTION
================================= */

section {
    padding: 80px 8%;
}

.section-title {
    text-align: center;

    font-size: 38px;

    color: #0f172a;

    margin-bottom: 10px;
}

.section-subtitle {
    text-align: center;

    color: #64748b;

    margin-bottom: 45px;
}


/* ==============================
   ABOUT
================================= */

.about {
    background-color: white;
}

.about-content {
    max-width: 850px;

    margin: auto;

    text-align: center;
}

.about-content p {
    color: #475569;

    font-size: 17px;

    margin-bottom: 18px;
}


/* ==============================
   SKILLS
================================= */

.skills {
    background-color: #f8fafc;
}

.skills-grid {
    max-width: 1100px;

    margin: auto;

    display: grid;

    grid-template-columns: repeat(3, 1fr);

    gap: 25px;
}

.skill-card {
    background-color: white;

    padding: 30px;

    text-align: center;

    border-radius: 12px;

    border: 1px solid #e2e8f0;

    transition: 0.3s;
}

.skill-card:hover {
    transform: translateY(-5px);

    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
}

.skill-icon {
    width: 60px;
    height: 60px;

    display: flex;
    justify-content: center;
    align-items: center;

    margin: auto;
    margin-bottom: 15px;

    border-radius: 12px;

    background-color: #e0f2fe;

    color: #0284c7;

    font-weight: bold;
}

.skill-card h3 {
    margin-bottom: 8px;

    color: #0f172a;
}

.skill-card p {
    color: #64748b;
}


/* ==============================
   PROJECTS
================================= */

.projects {
    background-color: white;
}

.project-container {
    max-width: 1000px;

    margin: auto;

    display: grid;

    grid-template-columns: repeat(2, 1fr);

    gap: 30px;
}

.project-card {
    position: relative;

    padding: 35px;

    background-color: #f8fafc;

    border-radius: 14px;

    border: 1px solid #e2e8f0;

    transition: 0.3s;
}

.project-card:hover {
    transform: translateY(-5px);

    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
}

.project-number {
    color: #0284c7;

    font-size: 15px;

    font-weight: bold;

    margin-bottom: 10px;
}

.project-card h3 {
    font-size: 23px;

    color: #0f172a;

    margin-bottom: 15px;
}

.project-card p {
    color: #64748b;

    margin-bottom: 20px;
}

.project-tech {
    display: flex;

    flex-wrap: wrap;

    gap: 8px;

    margin-bottom: 20px;
}

.project-tech span {
    padding: 6px 10px;

    background-color: #e0f2fe;

    color: #0369a1;

    border-radius: 5px;

    font-size: 12px;
}

.project-link {
    color: #0284c7;

    text-decoration: none;

    font-weight: bold;
}


/* ==============================
   CONTACT
================================= */

.contact {
    background-color: #f0f9ff;

    text-align: center;
}

.contact-box {
    max-width: 900px;

    margin: auto;

    display: grid;

    grid-template-columns: repeat(2, 1fr);

    gap: 20px;
}

.contact-item {
    padding: 25px;

    background-color: white;

    border-radius: 10px;

    border: 1px solid #e2e8f0;
}

.contact-item h3 {
    color: #0f172a;

    margin-bottom: 5px;
}

.contact-item p,
.contact-item a {
    color: #0284c7;

    text-decoration: none;
}


/* ==============================
   FOOTER
================================= */

footer {
    background-color: #0f172a;

    color: white;

    text-align: center;

    padding: 40px 8%;
}

footer h3 {
    font-size: 25px;

    color: #38bdf8;

    margin-bottom: 5px;
}

footer > p {
    color: #cbd5e1;
}

.social-links {
    margin: 20px 0;
}

.social-links a {
    color: white;

    text-decoration: none;

    margin: 0 12px;
}

.social-links a:hover {
    color: #38bdf8;
}

.copyright {
    font-size: 13px;

    margin-top: 20px;
}


/* ==============================
   RESPONSIVE DESIGN
================================= */

@media (max-width: 768px) {

    .navbar {
        flex-direction: column;

        gap: 15px;
    }

    .navbar nav {
        flex-wrap: wrap;

        justify-content: center;

        gap: 15px;
    }


    .hero {
        flex-direction: column;

        text-align: center;

        padding: 60px 6%;
    }

    .hero h1 {
        font-size: 40px;
    }

    .hero h2 {
        font-size: 20px;
    }

    .profile-circle {
        width: 190px;
        height: 190px;
    }

    .profile-circle span {
        font-size: 50px;
    }


    .skills-grid {
        grid-template-columns: 1fr;
    }


    .project-container {
        grid-template-columns: 1fr;
    }


    .contact-box {
        grid-template-columns: 1fr;
    }


    section {
        padding: 60px 6%;
    }

    .section-title {
        font-size: 30px;
    }

}