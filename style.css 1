/* ---------- General Styles ---------- */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, sans-serif;
    line-height: 1.6;
    color: #222;
    background-color: #ffffff;
}


/* ---------- Navigation Bar ---------- */

.navbar {
    position: sticky;
    top: 0;
    z-index: 1000;

    display: flex;
    justify-content: space-between;
    align-items: center;

    padding: 18px 8%;

    background-color: #172554;
    color: white;
}

.logo {
    font-size: 28px;
    font-weight: bold;
}

.navbar nav {
    display: flex;
    gap: 28px;
}

.navbar a {
    color: white;
    text-decoration: none;
    font-size: 16px;
}

.navbar a:hover {
    color: #93c5fd;
}


/* ---------- Hero Section ---------- */

.hero {
    min-height: 85vh;

    display: flex;
    justify-content: center;
    align-items: center;

    text-align: center;

    padding: 60px 8%;

    background: linear-gradient(
        135deg,
        #dbeafe,
        #eff6ff
    );
}

.hero-content {
    max-width: 750px;
}

.hero h1 {
    font-size: 52px;
    line-height: 1.2;
    margin-bottom: 20px;
    color: #172554;
}

.hero p {
    font-size: 20px;
    margin-bottom: 30px;
    color: #475569;
}


/* ---------- Button ---------- */

.btn {
    display: inline-block;

    padding: 13px 28px;

    background-color: #2563eb;
    color: white;

    text-decoration: none;

    border-radius: 8px;

    font-weight: bold;

    transition: 0.3s;
}

.btn:hover {
    background-color: #1d4ed8;
    transform: translateY(-2px);
}


/* ---------- Common Section ---------- */

section {
    padding: 80px 8%;
}

section h2 {
    text-align: center;
    font-size: 36px;
    color: #172554;
    margin-bottom: 15px;
}

.section-text {
    text-align: center;
    color: #64748b;
    margin-bottom: 45px;
}


/* ---------- Features ---------- */

.features {
    background-color: #ffffff;
}

.feature-container {
    display: flex;
    justify-content: center;
    gap: 25px;

    max-width: 1100px;
    margin: auto;
}

.feature-card {
    flex: 1;

    padding: 30px;

    text-align: center;

    background-color: #f8fafc;

    border: 1px solid #e2e8f0;
    border-radius: 12px;

    transition: 0.3s;
}

.feature-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
}

.feature-card h3 {
    font-size: 22px;
    color: #2563eb;
    margin-bottom: 12px;
}

.feature-card p {
    color: #64748b;
}


/* ---------- About ---------- */

.about {
    background-color: #eff6ff;
}

.about-content {
    max-width: 850px;
    margin: auto;
    text-align: center;
}

.about h2 {
    margin-bottom: 25px;
}

.about p {
    color: #475569;
    margin-bottom: 15px;
    font-size: 17px;
}


/* ---------- Contact ---------- */

.contact {
    text-align: center;
    background-color: #ffffff;
}

.contact p {
    color: #64748b;
    margin-bottom: 25px;
}


/* ---------- Footer ---------- */

footer {
    background-color: #172554;
    color: white;

    text-align: center;

    padding: 40px 8%;
}

.footer-content h3 {
    font-size: 26px;
    margin-bottom: 8px;
}

.footer-content p {
    color: #cbd5e1;
}

.footer-links {
    margin: 20px 0;
}

.footer-links a {
    color: white;
    text-decoration: none;
    margin: 0 12px;
}

.footer-links a:hover {
    color: #93c5fd;
}

.copyright {
    font-size: 14px;
    margin-top: 20px;
}


/* ---------- Responsive Design ---------- */

@media (max-width: 768px) {

    .navbar {
        flex-direction: column;
        gap: 12px;
    }

    .navbar nav {
        gap: 15px;
        flex-wrap: wrap;
        justify-content: center;
    }

    .hero {
        min-height: 75vh;
    }

    .hero h1 {
        font-size: 38px;
    }

    .hero p {
        font-size: 17px;
    }

    .feature-container {
        flex-direction: column;
    }

    section {
        padding: 60px 6%;
    }

    section h2 {
        font-size: 30px;
    }

    .footer-links a {
        display: inline-block;
        margin: 5px 8px;
    }
}