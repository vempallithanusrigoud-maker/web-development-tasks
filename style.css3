/* =========================
   BASIC RESET
========================= */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;

    min-height: 100vh;

    display: flex;
    justify-content: center;
    align-items: center;

    background: linear-gradient(
        135deg,
        #dbeafe,
        #e0f2fe
    );

    color: #1e293b;
}


/* =========================
   MAIN CONTAINER
========================= */

.container {
    width: 100%;

    padding: 30px;
}

.converter {
    max-width: 500px;

    margin: auto;

    padding: 35px;

    background-color: white;

    border-radius: 18px;

    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.12);
}


/* =========================
   HEADING
========================= */

h1 {
    text-align: center;

    font-size: 32px;

    color: #0f172a;

    margin-bottom: 10px;
}

.subtitle {
    text-align: center;

    color: #64748b;

    font-size: 15px;

    margin-bottom: 30px;
}


/* =========================
   FORM
========================= */

.form-group {
    margin-bottom: 20px;
}

label {
    display: block;

    font-weight: bold;

    margin-bottom: 8px;

    color: #334155;
}

input,
select {
    width: 100%;

    padding: 13px;

    font-size: 16px;

    border: 1px solid #cbd5e1;

    border-radius: 8px;

    outline: none;
}

input:focus,
select:focus {
    border-color: #2563eb;

    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
}


/* =========================
   BUTTON
========================= */

button {
    width: 100%;

    padding: 14px;

    border: none;

    border-radius: 8px;

    background-color: #2563eb;

    color: white;

    font-size: 17px;

    font-weight: bold;

    cursor: pointer;

    transition: 0.3s;
}

button:hover {
    background-color: #1d4ed8;
}


/* =========================
   ERROR
========================= */

#error {
    min-height: 24px;

    margin-top: 15px;

    text-align: center;

    color: #dc2626;

    font-weight: bold;
}


/* =========================
   RESULTS
========================= */

.results {
    margin-top: 25px;
}

.results h2 {
    text-align: center;

    font-size: 22px;

    margin-bottom: 15px;

    color: #0f172a;
}

.result-card {
    display: flex;

    justify-content: space-between;

    align-items: center;

    padding: 15px;

    margin-bottom: 10px;

    background-color: #f8fafc;

    border: 1px solid #e2e8f0;

    border-radius: 8px;
}

.result-card span {
    color: #475569;

    font-weight: bold;
}

.result-card strong {
    color: #2563eb;
}


/* =========================
   RESPONSIVE DESIGN
========================= */

@media (max-width: 600px) {

    .container {
        padding: 15px;
    }

    .converter {
        padding: 25px 20px;
    }

    h1 {
        font-size: 27px;
    }

    .subtitle {
        font-size: 14px;
    }
}