// Get HTML elements

const temperatureInput = document.getElementById("temperature");
const unitSelect = document.getElementById("unit");
const convertBtn = document.getElementById("convertBtn");

const errorMessage = document.getElementById("error");

const celsiusResult = document.getElementById("celsiusResult");
const fahrenheitResult = document.getElementById("fahrenheitResult");
const kelvinResult = document.getElementById("kelvinResult");


// Convert button

convertBtn.addEventListener("click", function () {

    // Get input value

    const inputValue = temperatureInput.value.trim();

    // Validate empty input

    if (inputValue === "") {

        errorMessage.textContent =
            "Please enter a temperature value.";

        clearResults();

        return;
    }


    // Convert string to number

    const temperature = Number(inputValue);


    // Validate non-numeric input

    if (isNaN(temperature)) {

        errorMessage.textContent =
            "Please enter a valid numeric value.";

        clearResults();

        return;
    }


    // Get selected unit

    const unit = unitSelect.value;

    let celsius;
    let fahrenheit;
    let kelvin;


    // Celsius input

    if (unit === "celsius") {

        celsius = temperature;

        fahrenheit = (temperature * 9 / 5) + 32;

        kelvin = temperature + 273.15;
    }


    // Fahrenheit input

    else if (unit === "fahrenheit") {

        celsius = (temperature - 32) * 5 / 9;

        fahrenheit = temperature;

        kelvin = celsius + 273.15;
    }


    // Kelvin input

    else if (unit === "kelvin") {

        celsius = temperature - 273.15;

        fahrenheit = (celsius * 9 / 5) + 32;

        kelvin = temperature;
    }


    // Absolute zero validation

    if (kelvin < 0) {

        errorMessage.textContent =
            "Temperature cannot be below absolute zero.";

        clearResults();

        return;
    }


    // Clear error

    errorMessage.textContent = "";


    // Display results

    celsiusResult.textContent =
        celsius.toFixed(2) + " °C";

    fahrenheitResult.textContent =
        fahrenheit.toFixed(2) + " °F";

    kelvinResult.textContent =
        kelvin.toFixed(2) + " K";

});


// Clear result function

function clearResults() {

    celsiusResult.textContent = "-- °C";

    fahrenheitResult.textContent = "-- °F";

    kelvinResult.textContent = "-- K";
}